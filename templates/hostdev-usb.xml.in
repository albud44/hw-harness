<!-- Generated by bin/hostdev; @USB_VID@/@USB_PID@ come from harness.conf.
     Matching by vendor/product rather than bus/device address means the
     snippet survives replugging the device into a different port. -->
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source>
    <vendor id='0x@USB_VID@'/>
    <product id='0x@USB_PID@'/>
  </source>
</hostdev>
